<launch>
  <arg name="mid360_msg_topic" default="/livox/lidar"/>
  <arg name="start_converter" default="true"/>
  <arg name="parent_pc_topic" default="/livox/lidar_pointcloud2"/>
  <arg name="child_pc_topic1" default="/left_rslidar_points"/>
  <arg name="child_pc_topic2" default="/front_rslidar_points"/>
  <arg name="child_pc_topic3" default="/right_rslidar_points"/>
  <arg name="filtered_parent_pc_topic" default="/livox/lidar_filter"/>
  <arg name="filtered_child_pc_topic1" default="/left_rslidar_points_filter"/>
  <arg name="filtered_child_pc_topic2" default="/front_rslidar_points_filter"/>
  <arg name="filtered_child_pc_topic3" default="/right_rslidar_points_filter"/>
  <arg name="max_range" default="3.0"/>
  <arg name="ground_z_threshold" default="0.0"/>
  <arg name="enable_range_filter" default="true"/>
  <arg name="enable_ground_filter" default="true"/>
  <arg name="ground_filter_topics" default="['$(arg child_pc_topic1)', '$(arg child_pc_topic2)', '$(arg child_pc_topic3)']"/>

  <node if="$(arg start_converter)" pkg="pointcloud_fusion" type="mid360_to_pointcloud2"
        name="mid360_to_pointcloud2" output="screen">
    <param name="input_topic" value="$(arg mid360_msg_topic)"/>
    <param name="output_topic" value="$(arg parent_pc_topic)"/>
  </node>
  <node pkg="pointcloud_fusion" type="pointcloud_filter_node" name="pointcloud_filter" output="screen">
    <param name="max_range" value="$(arg max_range)" type="double"/>
    <param name="ground_z_threshold" value="$(arg ground_z_threshold)" type="double"/>
    <param name="enable_range_filter" value="$(arg enable_range_filter)"/>
    <param name="enable_ground_filter" value="$(arg enable_ground_filter)"/>
    <rosparam param="input_topics" subst_value="true">['$(arg parent_pc_topic)', '$(arg child_pc_topic1)', '$(arg child_pc_topic2)', '$(arg child_pc_topic3)']</rosparam>
    <rosparam param="output_topics" subst_value="true">['$(arg filtered_parent_pc_topic)', '$(arg filtered_child_pc_topic1)', '$(arg filtered_child_pc_topic2)', '$(arg filtered_child_pc_topic3)']</rosparam>
    <rosparam param="ground_filter_topics" subst_value="true">$(arg ground_filter_topics)</rosparam>
  </node>
</launch>
