<launch>
  <arg name="mid360_msg_topic" default="/livox/lidar"/>
  <arg name="start_converter" default="true"/>
  <arg name="parent_pc_topic" default="/livox/lidar_pointcloud2"/>
  <arg name="child_pc_topic1" default="/left_rslidar_points"/>
  <arg name="child_pc_topic2" default="/front_rslidar_points"/>
  <arg name="child_pc_topic3" default="/right_rslidar_points"/>
  <arg name="config" default="$(find pointcloud_fusion)/config/fusion.yaml"/>
  <arg name="fusion_pc_topic" default="/pointcloud_fused"/>
  <arg name="fusion_pc_frame_id" default="mid_laser_link"/>
  <arg name="extrinsics_ready" default="false"/>
  <arg name="broadcast_tf" default="true"/>
  <arg name="enable_filter" default="false"/>
  <arg name="max_range" default="3.0"/>
  <arg name="ground_z_threshold" default="0.0"/>
  <arg name="enable_range_filter" default="true"/>
  <arg name="enable_ground_filter" default="true"/>
  <arg name="ground_filter_topics" default="['$(arg child_pc_topic1)', '$(arg child_pc_topic2)', '$(arg child_pc_topic3)']"/>
  <arg name="set_params" default="false"/>
  <arg name="open_tuning_gui" default="false"/>
  <arg name="publish_scan" default="true"/>
  <arg name="scan_topic" default="/scan"/>
  <arg name="scan_target_frame" default=""/>
  <arg name="scan_time" default="0.1"/>

  <node if="$(arg start_converter)" pkg="pointcloud_fusion" type="mid360_to_pointcloud2"
        name="mid360_to_pointcloud2" output="screen">
    <param name="input_topic" value="$(arg mid360_msg_topic)"/>
    <param name="output_topic" value="$(arg parent_pc_topic)"/>
    <param name="output_frame_id" value="$(arg fusion_pc_frame_id)" type="string"/>
  </node>

  <node pkg="pointcloud_fusion" type="pointcloud_fusion_node" name="pointcloud_fusion"
        output="screen" required="true">
    <rosparam command="load" file="$(arg config)"/>
    <param name="topics/parent_pc_topic" value="$(arg parent_pc_topic)"/>
    <param name="topics/child_pc_topic1" value="$(arg child_pc_topic1)"/>
    <param name="topics/child_pc_topic2" value="$(arg child_pc_topic2)"/>
    <param name="topics/child_pc_topic3" value="$(arg child_pc_topic3)"/>
    <param name="topics/fusion_pc_topic" value="$(arg fusion_pc_topic)"/>
    <param name="topics/fusion_pc_frame_id" value="$(arg fusion_pc_frame_id)" type="string"/>
    <param name="extrinsics_ready" value="$(arg extrinsics_ready)"/>
    <param name="broadcast_tf" value="$(arg broadcast_tf)" type="bool"/>
    <param name="set_dynamic_params" value="$(arg set_params)"/>
    <param name="enable_filter" value="$(arg enable_filter)" type="bool"/>
    <param name="enable_range_filter" value="$(arg enable_range_filter)" type="bool"/>
    <param name="enable_ground_filter" value="$(arg enable_ground_filter)" type="bool"/>
    <param name="max_range" value="$(arg max_range)" type="double"/>
    <param name="ground_z_threshold" value="$(arg ground_z_threshold)" type="double"/>
    <rosparam param="ground_filter_topics" subst_value="true">$(arg ground_filter_topics)</rosparam>
  </node>

  <include if="$(arg publish_scan)" file="$(find lm_bringup)/launch/PointsCloud2toLaserscan.launch">
    <arg name="cloud_topic" value="$(arg fusion_pc_topic)"/>
    <arg name="scan_topic" value="$(arg scan_topic)"/>
    <arg name="target_frame" value="$(arg scan_target_frame)"/>
    <arg name="scan_time" value="$(arg scan_time)"/>
  </include>

  <group if="$(arg open_tuning_gui)">
    <node pkg="rviz" type="rviz" name="fusion_rviz"
          args="-d $(find pointcloud_fusion)/rviz/fusion.rviz">
      <remap from="/pointcloud_fused" to="$(arg fusion_pc_topic)"/>
    </node>
    <node pkg="rqt_reconfigure" type="rqt_reconfigure" name="fusion_tuning"/>
  </group>
</launch>
